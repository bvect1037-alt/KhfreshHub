                    -- Floating List đặt ở TopLayerFrame để không bị ô Bento bên dưới đè
                    local FloatMenu = Instance.new("Frame")
                    FloatMenu.Name = "FloatDropdownMenu"
                    FloatMenu.BackgroundColor3 = BentoUI.Themes.HeaderBackground
                    FloatMenu.Visible = false
                    FloatMenu.ZIndex = 99999
                    FloatMenu.Parent = TopLayerFrame

                    Utils.CreateCorner(FloatMenu, 6)
                    Utils.CreateStroke(FloatMenu, BentoUI.Themes.BorderActive, 1)

                    local FloatList = Instance.new("UIListLayout")
