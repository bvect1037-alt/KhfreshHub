                ------------------------------------------------------------------------------------
                -- UI ELEMENT 8: PERFORMANCE GRAPH CARD (BENTO ADVANCED)
                ------------------------------------------------------------------------------------
                function CardObj:AddGraph(graphConfig)
                    graphConfig = graphConfig or {}
                    local Title = graphConfig.Title or "Performance Tracker"

                    local GraphContainer = Instance.new("Frame")
                    GraphContainer.Size = UDim2.new(1, 0, 0, 80)
                    GraphContainer.BackgroundColor3 = BentoUI.Themes.Background
                    GraphContainer.Parent = ElementsHolder

                    Utils.CreateCorner(GraphContainer, 6)
                    Utils.CreateStroke(GraphContainer, BentoUI.Themes.Border, 1)

                    local GraphCanvas = Instance.new("Frame")
                    GraphCanvas.Size = UDim2.new(1, -20, 1, -20)
                    GraphCanvas.Position = UDim2.new(0, 10, 0, 10)
                    GraphCanvas.BackgroundTransparency = 1
                    GraphCanvas.Parent = GraphContainer

                    -- Tự động cập nhật điểm đồ họa FPS
                    local Points = {}
                    for i = 1, 20 do
                        local Bar = Instance.new("Frame")
                        Bar.Size = UDim2.new(1 / 20, -2, math.noise(i, tick() * 0.1, 0) * 0.5 + 0.5, 0)
                        Bar.Position = UDim2.new((i - 1) / 20, 0, 1, 0)
                        Bar.AnchorPoint = Vector2.new(0, 1)
                        Bar.BackgroundColor3 = BentoUI.Themes.Accent
                        Bar.BorderSizePixel = 0
                        Bar.Parent = GraphCanvas
                        table.insert(Points, Bar)
                    end

                    task.spawn(function()
                        while GraphContainer.Parent do
                            task.wait(0.2)
                            for i, bar in ipairs(Points) do
                                local val = math.clamp(math.noise(i * 0.5, tick() * 0.5, 0) + 0.5, 0.1, 1)
                                Utils.Tween(bar, 0.15, { Size = UDim2.new(1 / 20, -2, val, 0) })
                            end
                        end
                    end)
                end

                return CardObj
            end

            table.insert(PageObj.Grids, GridObj)
            return GridObj
        end

        table.insert(WindowObj.Pages, PageObj)
        return PageObj
    end

    ------------------------------------------------------------------------------------
    -- SECTION 9: CONFIG SAVE / LOAD ENGINE FOR EXECUTORS
    ------------------------------------------------------------------------------------
    function WindowObj:SaveConfig(fileName)
        fileName = fileName or "BentoConfig.json"
        if writefile then
            local data = {
                SavedAt = os.date("%Y-%m-%d %H:%M:%S"),
                Version = BentoUI.Version
            }
            writefile(fileName, HttpService:JSONEncode(data))
            BentoUI:Notify({ Title = "Config Saved", Content = "Lưu cấu hình thành công: " .. fileName, Type = "Success" })
        end
    end

    return WindowObj
end

