-- SECTION 4: BENTO GRID LAYOUT ENGINE (MATHEMATICAL ALGORITHM)
------------------------------------------------------------------------------------
local BentoEngine = {}
BentoEngine.__index = BentoEngine

function BentoEngine.new(columns, padding, cellHeight)
    local self = setmetatable({}, BentoEngine)
    self.Columns = columns or 3
    self.Padding = padding or 10
    self.CellHeight = cellHeight or 130
    self.GridMatrix = {} -- [Row][Col] = true/false
    return self
end

function BentoEngine:IsAvailable(row, col, rSpan, cSpan)
    for r = row, row + rSpan - 1 do
        for c = col, col + cSpan - 1 do
            if self.GridMatrix[r] and self.GridMatrix[r][c] then
                return false
            end
        end
    end
    return true
end

function BentoEngine:MarkOccupied(row, col, rSpan, cSpan)
    for r = row, row + rSpan - 1 do
        self.GridMatrix[r] = self.GridMatrix[r] or {}
        for c = col, col + cSpan - 1 do
            self.GridMatrix[r][c] = true
        end
    end
end

function BentoEngine:FindSlot(rSpan, cSpan)
    local row = 1
    while true do
        for col = 1, (self.Columns - cSpan + 1) do
            if self:IsAvailable(row, col, rSpan, cSpan) then
                return row, col
            end
        end
        row = row + 1
    end
end

function BentoEngine:CalculateBounds(row, col, rSpan, cSpan, totalWidth)
    local cellWidth = (totalWidth - (self.Padding * (self.Columns - 1))) / self.Columns
    local width = (cellWidth * cSpan) + (self.Padding * (cSpan - 1))
    local height = (self.CellHeight * rSpan) + (self.Padding * (rSpan - 1))
    local posX = (col - 1) * (cellWidth + self.Padding)
    local posY = (row - 1) * (self.CellHeight + self.Padding)

    return UDim2.new(0, width, 0, height), UDim2.new(0, posX, 0, posY), posY + height
end

