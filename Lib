                ------------------------------------------------------------------------------------
                -- UI ELEMENT 3: SLIDER
                ------------------------------------------------------------------------------------
                function CardObj:AddSlider(sliderConfig)
                    sliderConfig = sliderConfig or {}
                    local Text = sliderConfig.Title or "Slider Option"
                    local Min = sliderConfig.Min or 0
                    local Max = sliderConfig.Max or 100
                    local Default = sliderConfig.Default or Min
                    local Suffix = sliderConfig.Suffix or ""
                    local Callback = sliderConfig.Callback or function() end

                    local Value = math.clamp(Default, Min, Max)

                    local SliderFrame = Instance.new("Frame")
                    SliderFrame.Name = "Element_Slider"
                    SliderFrame.Size = UDim2.new(1, 0, 0, 48)
                    SliderFrame.BackgroundColor3 = BentoUI.Themes.ItemBg
                    SliderFrame.Parent = ElementsHolder

                    Utils.CreateCorner(SliderFrame, 6)
                    Utils.CreateStroke(SliderFrame, BentoUI.Themes.Border, 1)

                    local Label = Instance.new("TextLabel")
                    Label.Size = UDim2.new(0.6, 0, 0, 20)
                    Label.Position = UDim2.new(0, 10, 0, 6)
                    Label.BackgroundTransparency = 1
                    Label.Font = BentoUI.Font
                    Label.Text = Text
                    Label.TextColor3 = BentoUI.Themes.TextPrimary
                    Label.TextSize = 13
                    Label.TextXAlignment = Enum.TextXAlignment.Left
                    Label.Parent = SliderFrame

                    local ValueLabel = Instance.new("TextLabel")
                    ValueLabel.Size = UDim2.new(0.4, -10, 0, 20)
                    ValueLabel.Position = UDim2.new(0.6, 0, 0, 6)
                    ValueLabel.BackgroundTransparency = 1
                    ValueLabel.Font = BentoUI.FontBold
                    ValueLabel.Text = tostring(Value) .. Suffix
                    ValueLabel.TextColor3 = BentoUI.Themes.Accent
                    ValueLabel.TextSize = 13
                    ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
                    ValueLabel.Parent = SliderFrame

                    local Track = Instance.new("Frame")
                    Track.Size = UDim2.new(1, -20, 0, 6)
                    Track.Position = UDim2.new(0, 10, 0, 32)
                    Track.BackgroundColor3 = BentoUI.Themes.Border
                    Track.BorderSizePixel = 0
                    Track.Parent = SliderFrame

                    Utils.CreateCorner(Track, 3)

                    local Fill = Instance.new("Frame")
                    Fill.Size = UDim2.new((Value - Min) / (Max - Min), 0, 1, 0)
                    Fill.BackgroundColor3 = BentoUI.Themes.Accent
                    Fill.BorderSizePixel = 0
                    Fill.Parent = Track

                    Utils.CreateCorner(Fill, 3)

                    local Dragging = false

                    local function Update(input)
                        local percentage = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                        Value = math.floor(Min + (Max - Min) * percentage)
                        ValueLabel.Text = tostring(Value) .. Suffix
                        Utils.Tween(Fill, 0.05, { Size = UDim2.new(percentage, 0, 1, 0) })
                        Callback(Value)
                    end

                    Track.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            Dragging = true
                            Update(input)
                        end
                    end)

                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            Dragging = false
                        end
                    end)

                    UserInputService.InputChanged:Connect(function(input)
                        if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                            Update(input)
                        end
                    end)
                end

