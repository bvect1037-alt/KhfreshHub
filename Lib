                    Trigger.BackgroundTransparency = 1
                    Trigger.Text = ""
                    Trigger.Parent = DropFrame

                    local function ToggleMenu()
                        Expanded = not Expanded
                        if Expanded then
                            FloatMenu.Size = UDim2.new(0, DropFrame.AbsoluteSize.X, 0, #Options * 28)
                            FloatMenu.Position = UDim2.new(0, DropFrame.AbsolutePosition.X, 0, DropFrame.AbsolutePosition.Y + 40)
                            FloatMenu.Visible = true
                            Arrow.Text = "▲"
                        else
                            FloatMenu.Visible = false
                            Arrow.Text = "▼"
                        end
                    end

                    Trigger.MouseButton1Click:Connect(ToggleMenu)

                    for _, opt in ipairs(Options) do
                        local Item = Instance.new("TextButton")
                        Item.Size = UDim2.new(1, 0, 0, 26)
                        Item.BackgroundColor3 = BentoUI.Themes.ItemBg
                        Item.Text = opt
                        Item.Font = BentoUI.Font
                        Item.TextColor3 = BentoUI.Themes.TextSecondary
                        Item.TextSize = 12
                        Item.AutoButtonColor = false
                        Item.Parent = FloatMenu

                        Item.MouseEnter:Connect(function()
                            Utils.Tween(Item, 0.1, { BackgroundColor3 = BentoUI.Themes.Accent, TextColor3 = BentoUI.Themes.TextPrimary })
                        end)

                        Item.MouseLeave:Connect(function()
                            Utils.Tween(Item, 0.1, { BackgroundColor3 = BentoUI.Themes.ItemBg, TextColor3 = BentoUI.Themes.TextSecondary })
                        end)

                        Item.MouseButton1Click:Connect(function()
                            Selected = opt
                            SelectedLabel.Text = Selected
                            Callback(Selected)
                            ToggleMenu()
                        end)
                    end
                end

