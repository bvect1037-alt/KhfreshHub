                    Arrow.Position = UDim2.new(1, -25, 0, 0)
                    Arrow.BackgroundTransparency = 1
                    Arrow.Font = BentoUI.FontBold
                    Arrow.Text = "▼"
                    Arrow.TextColor3 = BentoUI.Themes.TextSecondary
                    Arrow.TextSize = 10
